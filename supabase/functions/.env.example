# Edge Function secrets — set with `supabase secrets set` (never in the frontend).

# Resend API key (https://resend.com). Server-side only.
RESEND_API_KEY=

# The From header for quote emails. IMPORTANT: the sender address/domain must be
# verified in your Resend account (or use Resend's onboarding sender for tests).
# Emails from unverified domains are rejected by the provider.
EMAIL_FROM=0Gauge Quotes <quotes@example.com>

# Public base URL of the deployed frontend — used to build quote links in emails.
APP_URL=http://localhost:5173
