// Super Car Audio's deployment of the same app.
//
// NOT a second copy of the software. One repository, one branch, one commit —
// this file only says where a build of it gets uploaded.
//
// A separate config exists because Cloudflare requires a Worker and the
// domain it serves to live in the SAME account, and this shop's domain sits
// in their own Cloudflare account rather than the platform's.
//
// Nobody runs this by hand. Cloudflare builds it, the same way it builds the
// platform: the shop's Cloudflare account watches this repository, and a push
// deploys to both accounts. See docs/CUSTOM_DOMAINS.md for the three build
// settings that make that happen.
//
// To add another client: copy this file, change `name` and `account_id`, and
// connect the repository in their Cloudflare account.
{
  "name": "supercaraudio",
  "compatibility_date": "2025-01-01",
  // Super Car Audio's own Cloudflare account. Not a secret — it is in the
  // address bar of every page of their dashboard, and it can do nothing
  // without an API token. Deploying here needs your account to be a member of
  // theirs; see docs/CUSTOM_DOMAINS.md.
  "account_id": "ab33adc9ae6bd1ab08daba89c38b5c18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
